rules_version = '2';

// Reglas de seguridad de Firestore.
// Por defecto se deniega todo; cada colección se habilita explícitamente
// según los roles definidos en docs/roadmap.md (jugador, staff, coordinación, admin).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
